# GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional tuning (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=models/gemini-embedding-001
# RAG_TOP_K=4
# RAG_FETCH_K=8
# RAG_MULTI_QUERY=0   # 1 = query expansion (better recall, slower)
# RAG_RERANK=0         # 1 = LLM re-ranking (better precision, slower)
# RAG_DEBUG=0          # 1 = print retrieval timings

# Owner notifications (optional). Without these, notifications are printed and saved to notifications.log
# OWNER_EMAIL=owner@yourbusiness.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_gmail_app_password

# Customer messages (optional). Without these, messages are only written to customer_messages.log
# BUSINESS_NAME=Your Business Name
# REMINDER_HOURS=24
# Email to customers reuses the SMTP_* settings above. For SMS/WhatsApp (phone must be like +15551234567):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111        # or whatsapp:+14155238886
# Retrieval chain (grounded answer, +1 LLM call). 0 = raw passages, faster
# RAG_USE_CHAIN=1
